# =============================================================================
# ENVIRONMENT VARIABLES TEMPLATE
# Copy this file to .env and fill in your actual values
# NEVER commit the .env file to version control
# =============================================================================

# ======================= SERVER =======================
PORT=8080
SPRING_PROFILES_ACTIVE=h2        # Options: h2, dev, prod

# ======================= DATABASE (dev/prod only) =======================
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ecommerce_db
DB_USER=root
DB_PASSWORD=your_db_password

# For prod (full JDBC URL)
DATABASE_URL=jdbc:mysql://localhost:3306/ecommerce_db
DB_USERNAME=root

# ======================= JWT SECRETS =======================
JWT_ACCESS_SECRET=your-access-secret-key-must-be-at-least-32-characters-long
JWT_REFRESH_SECRET=your-refresh-secret-key-must-be-at-least-32-characters-long
JWT_ACCESS_TOKEN_EXPIRATION=900000       # 15 minutes in ms
JWT_REFRESH_TOKEN_EXPIRATION=604800000   # 7 days in ms

# ======================= ADMIN BOOTSTRAP =======================
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=YourStrongPassword123!
ADMIN_FULL_NAME=Administrator

# ======================= EMAIL (SMTP) =======================
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your-email@gmail.com
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your_app_password
SHIPPING_TEAM_EMAIL=shipping@yourdomain.com

# ======================= GOOGLE OAUTH2 =======================
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8080/login/oauth2/code/google

# ======================= CLOUDINARY (Image Upload) =======================
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ======================= RAZORPAY (Payments) =======================
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# ======================= SECURITY =======================
SECURITY_MAX_FAILED_ATTEMPTS=5
SECURITY_LOCKOUT_DURATION_MINUTES=30
SECURITY_PASSWORD_RESET_TOKEN_EXPIRY_HOURS=24
OAUTH2_ENABLED=true
